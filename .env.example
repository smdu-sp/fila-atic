# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# --- Banco de dados
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/fila_atic_db"

# --- NextAuth
NEXTAUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# URL publica do sistema. Os links enviados por e-mail sao montados a partir dela.
NEXTAUTH_URL="http://localhost:3003"

# --- Login (LDAP / Active Directory)
LDAP_URL="ldap://servidor:389"
LDAP_BASE_DN="DC=exemplo,DC=gov,DC=br"
# Usuario de servico para a busca (opcional)
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""

# "local" pula o LDAP e aceita qualquer senha. So vale fora de producao.
ENVIRONMENT="local"

# --- Solicitacao publica (/solicitar), para quem nao tem conta
# Dominios de e-mail autorizados, separados por virgula. Vazio desativa a funcao.
PUBLIC_REQUEST_ALLOWED_DOMAINS="prefeitura.sp.gov.br"

# --- E-mail (SMTP). Sem SMTP_HOST, fora de producao o e-mail e impresso no console.
SMTP_HOST=""
SMTP_PORT="587"
# "true" para TLS implicito (normalmente porta 465)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Fila ATIC <fila@exemplo.gov.br>"

# --- Avisos de prazo (rota /api/cron/deadline-reminders)
# Segredo que autoriza o agendador do servidor a chamar a rota. Vazio desativa.
# Gere um valor longo e aleatorio; o agendador usa o mesmo valor (npm run cron:deadlines).
CRON_SECRET=""

# Segredo (bearer) que autoriza os workflows do GitHub a chamar
# /api/integrations/github. Gere um valor longo e aleatório (ver docs/github-runner.md).
# Vazio desativa a rota.
GITHUB_INTEGRATION_TOKEN=""

# --- Primeiro coordenador (npm run db:seed)
SEED_COORDINATOR_EMAIL=""
SEED_COORDINATOR_NAME=""
