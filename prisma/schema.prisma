generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  COORDINATOR
  DEV_GLOBAL
  DEV_RESTRICTED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  IN_QUEUE
  IN_ANALYSIS
  IN_DEVELOPMENT
  IN_TESTING
  FINISHED
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  WAITING
  PAUSED
  DONE
  DEPLOYED
}

model User {
  id                String             @id @default(uuid())
  login             String             @unique
  name              String
  email             String             @unique
  department        String
  role              Role               @default(REQUESTER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  requestedProjects Project[]          @relation("ProjectRequester")
  assignedProjects  ProjectDeveloper[]
  tasks             Task[]
}

model Project {
  id            String             @id @default(uuid())
  title         String
  description   String             @db.Text
  justification String             @db.Text
  status        ProjectStatus      @default(IN_QUEUE)
  priority      ProjectPriority    @default(MEDIUM)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  requesterId   String
  requester     User               @relation("ProjectRequester", fields: [requesterId], references: [id])
  developers    ProjectDeveloper[]
  tasks         Task[]
  logs          ProjectLog[]
}

model ProjectDeveloper {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProjectLog {
  id         String   @id @default(uuid())
  message    String   @db.Text
  projectId  String
  authorName String
  isInternal Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
