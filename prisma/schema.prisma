generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  COORDINATOR
  DEV_GLOBAL
  DEV_RESTRICTED
  // Same permissions as COORDINATOR (see isCoordination in lib/roles.ts).
  TECH_LEAD
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  IN_QUEUE
  IN_ANALYSIS
  IN_DEVELOPMENT
  IN_TESTING
  FINISHED
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  WAITING
  PAUSED
  DONE
  DEPLOYED
  CANCELED
}

enum ProjectCategory {
  BUG
  IMPROVEMENT
  NEW_SYSTEM
  SUPPORT
  OTHER
}

enum RequestFieldType {
  TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  RADIO
  DATE
}

model User {
  id                 String             @id @default(uuid())
  login              String             @unique
  name               String
  email              String             @unique
  department         String
  role               Role               @default(REQUESTER)
  isActive           Boolean            @default(true)
  // Created by the public request form after e-mail confirmation. Guests
  // cannot sign in; a coordinator registering the same e-mail promotes them.
  isGuest            Boolean            @default(false)
  // Also send notifications by e-mail (they always appear in the app).
  emailNotifications Boolean            @default(true)
  createdAt          DateTime           @default(now())
  notifications      Notification[]
  requestedProjects  Project[]          @relation("ProjectRequester")
  assignedProjects   ProjectDeveloper[]
  tasks              Task[]
}

model Project {
  id            String                     @id @default(uuid())
  // Sequential, human-facing identifier ("ATC-0001"); see lib/projectCode.ts.
  code          Int                        @unique @default(autoincrement())
  // Last Task.number handed out inside this project. A counter (instead of
  // max + 1) so a deleted task's number is never reused by another one.
  taskCounter   Int                        @default(0)
  title         String
  description   String                     @db.Text
  justification String                     @db.Text
  status        ProjectStatus              @default(IN_QUEUE)
  priority      ProjectPriority            @default(MEDIUM)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  requesterId   String
  requester     User                       @relation("ProjectRequester", fields: [requesterId], references: [id])
  // Secret in the public tracking link (/acompanhar/<token>) of requests
  // opened through the public form.
  trackingToken String?                    @unique
  // Delivery forecast set by the team. A date, not a moment: stored as DATE so
  // it never shifts with the time zone.
  dueDate       DateTime?                  @db.Date
  // Why the request was cancelled or refused; shown to the requester.
  closeReason   String?                    @db.Text
  // Kind of demand, set by the team when triaging.
  category      ProjectCategory?
  developers    ProjectDeveloper[]
  tasks         Task[]
  logs          ProjectLog[]
  requestValues ProjectRequestFieldValue[]
  statusChanges ProjectStatusChange[]
}

// One row per status change, so reports can tell how long a project stayed in
// each status. Rows written by the migration that introduced this table are a
// baseline (current status, dated by the last update) and only approximate.
model ProjectStatusChange {
  id            String         @id @default(uuid())
  projectId     String
  fromStatus    ProjectStatus?
  toStatus      ProjectStatus
  changedByName String
  createdAt     DateTime       @default(now())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectDeveloper {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id             String               @id @default(uuid())
  // 1, 2, 3... inside the project; "ATC-0001-3" is project code + number
  // (lib/taskCode.ts). This is what commit messages and branches cite. Left
  // at 0 on insert, a database trigger fills in the next number of the project
  // (migration task_number_trigger), whatever the way the task is created.
  number         Int                  @default(0)
  title          String
  description    String?              @db.Text
  status         TaskStatus           @default(TODO)
  dueDate        DateTime?            @db.Date
  priority       ProjectPriority      @default(MEDIUM)
  // Names of labels from the managed palette (model Label). Stored by name so
  // reads stay a single column; renaming or deleting a label rewrites them.
  labels         String[]             @default([])
  // Order inside a Kanban column (ascending). New tasks get -epoch seconds, so
  // they land on top; moving a card sets a value between its new neighbours.
  position       Float                @default(0)
  comments       TaskComment[]
  attachments    TaskAttachment[]
  githubActivity TaskGithubActivity[]
  assigneeId     String?
  assignee       User?                @relation(fields: [assigneeId], references: [id])
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([projectId, number])
}

// What GitHub told us about a task: a commit that cites it, a pull request, a
// deploy. Shown on the task; the dedupe key makes a repeated delivery harmless.
model TaskGithubActivity {
  id        String      @id @default(uuid())
  taskId    String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // "commit" | "pull_request" | "deploy"
  kind      String
  // "commit:<sha>", "pr:<number>:<state>", "deploy:<sha>"
  dedupeKey String
  title     String
  url       String?
  sha       String?
  author    String?
  // set when this event moved the task on the board
  movedTo   TaskStatus?
  createdAt DateTime    @default(now())

  @@unique([taskId, dedupeKey])
  @@index([taskId, createdAt])
}

// Every delivery received from the GitHub workflows, for troubleshooting.
model GithubEvent {
  id         String   @id @default(uuid())
  kind       String
  repository String
  ref        String?
  summary    String
  // "processed" | "ignored" | "failed"
  outcome    String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Single row (id "singleton"): whether the integration is on and what each
// GitHub event does to the board. The secret token is NOT here: it lives in
// GITHUB_INTEGRATION_TOKEN, like CRON_SECRET.
model GithubSettings {
  id                  String      @id @default("singleton")
  enabled             Boolean     @default(false)
  // "owner/name"; empty accepts any repository
  repositories        String[]    @default([])
  mainBranch          String      @default("main")
  // Target status per event; null leaves the task where it is.
  onPush              TaskStatus? @default(IN_PROGRESS)
  onPullRequestOpened TaskStatus? @default(TESTING)
  onMerge             TaskStatus? @default(DONE)
  onDeploy            TaskStatus? @default(DEPLOYED)
  // Never pull a task back to an earlier column (a late commit on a task that
  // is already done leaves it done).
  onlyForward         Boolean     @default(true)
  updatedAt           DateTime    @updatedAt
}

// Palette of task labels, registered by the coordination. Tasks can only use
// labels that exist here (compared ignoring case, see lib/labels.ts).
model Label {
  id        String   @id @default(uuid())
  name      String   @unique
  // "#rrggbb"
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id             String   @id @default(uuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String?
  fileSize       Int
  uploadedById   String
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([taskId])
}

model TaskStatusLabel {
  id        String     @id @default(uuid())
  status    TaskStatus @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ProjectLog {
  id          String                 @id @default(uuid())
  message     String                 @db.Text
  projectId   String
  authorName  String
  isInternal  Boolean                @default(false)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  attachments ProjectLogAttachment[]
}

model ProjectLogAttachment {
  id        String     @id @default(uuid())
  logId     String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int
  createdAt DateTime   @default(now())
  log       ProjectLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model ProjectRequestField {
  id          String                     @id @default(uuid())
  key         String?                    @unique
  label       String
  placeholder String
  helperText  String?                    @db.Text
  order       Int
  // Which step of the request wizard shows this field: 3 ("Dados da
  // solicitação") or 4 ("Detalhes"). Steps 1 (intro) and 2 (the guest's own
  // name/e-mail/department) are fixed and never hold a configurable field.
  step        Int                        @default(3)
  isSystem    Boolean                    @default(false)
  fieldType   RequestFieldType           @default(TEXT)
  options     String?                    @db.Text
  required    Boolean                    @default(false)
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  values      ProjectRequestFieldValue[]
}

// Public submission waiting for the e-mail confirmation link. Nothing reaches
// User/Project until it is confirmed, so unverified spam stays out of the queue.
// Something the person should know about: shown in the bell and, unless they
// opted out, sent by e-mail. dedupeKey (already scoped to the user) lets
// scheduled jobs run more than once without notifying twice.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?   @db.Text
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique

  @@index([userId, readAt, createdAt])
}

// One row per e-mail the system attempted to send: notifications, deadline
// reminders, guest-requester messages, confirmation links, admin test sends.
// Delivery is otherwise invisible in production (sendMail's caller only logs
// to the console), so this is what Administracao > E-mail shows.
model MailLog {
  id        String   @id @default(uuid())
  // "confirmation" | "tracking" | "guest_update" | "notification" | "test"
  kind      String
  to        String
  subject   String
  // "sent" (delivered or handed to the relay) | "skipped" (no SMTP_HOST,
  // outside production: printed to the console instead) | "failed"
  status    String
  // how many attempts it took (>1 means a transient failure was retried)
  attempts  Int      @default(1)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PendingGuestRequest {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  name          String
  email         String
  department    String
  title         String
  description   String   @db.Text
  justification String   @db.Text
  customFields  String?  @db.Text
  // JSON list of files uploaded with the form, kept until confirmation.
  attachments   String?  @db.Text
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([email])
  @@index([expiresAt])
}

// Rate limiting for the public routes (kind = "submit-ip", "submit-email", ...).
model PublicRequestAttempt {
  id        String   @id @default(uuid())
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

model ProjectRequestFieldValue {
  id        String              @id @default(uuid())
  projectId String
  fieldId   String
  value     String              @db.Text
  createdAt DateTime            @default(now())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field     ProjectRequestField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

// Internal wiki: a tree of pages, Markdown content. Never shown
// to requesters. Deleting a page deletes its whole subtree (see
// deleteNotebookPage, which also removes the files on disk first).
model NotebookPage {
  id            String                   @id @default(uuid())
  title         String
  content       String                   @db.Text
  parentId      String?
  parent        NotebookPage?            @relation("NotebookPageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      NotebookPage[]           @relation("NotebookPageTree")
  // Order among siblings (same idea as Task.position): lower comes first.
  position      Float                    @default(0)
  createdById   String
  createdByName String
  updatedByName String
  // +1 on every save that changes the title or the body (see the editor's
  // conflict check); moving the page in the tree does not count.
  version       Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  revisions     NotebookPageRevision[]
  attachments   NotebookPageAttachment[]

  @@index([parentId])
}

// One row per save that changed title or content: a light audit trail, not
// full version snapshots.
model NotebookPageRevision {
  id           String       @id @default(uuid())
  pageId       String
  page         NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editedByName String
  editedAt     DateTime     @default(now())

  @@index([pageId, editedAt])
}

// Images inserted inline in a page's Markdown (![alt](fileUrl)).
model NotebookPageAttachment {
  id             String       @id @default(uuid())
  pageId         String
  page           NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String?
  fileSize       Int
  uploadedById   String
  uploadedByName String
  createdAt      DateTime     @default(now())

  @@index([pageId])
}
