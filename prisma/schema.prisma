generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  COORDINATOR
  DEV_GLOBAL
  DEV_RESTRICTED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  IN_QUEUE
  IN_ANALYSIS
  IN_DEVELOPMENT
  IN_TESTING
  FINISHED
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  WAITING
  PAUSED
  DONE
  DEPLOYED
}

enum RequestFieldType {
  TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  RADIO
  DATE
}

model User {
  id                String             @id @default(uuid())
  login             String             @unique
  name              String
  email             String             @unique
  department        String
  role              Role               @default(REQUESTER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  requestedProjects Project[]          @relation("ProjectRequester")
  assignedProjects  ProjectDeveloper[]
  tasks             Task[]
}

model Project {
  id            String             @id @default(uuid())
  title         String
  description   String             @db.Text
  justification String             @db.Text
  status        ProjectStatus      @default(IN_QUEUE)
  priority      ProjectPriority    @default(MEDIUM)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  requesterId   String
  requester     User               @relation("ProjectRequester", fields: [requesterId], references: [id])
  developers    ProjectDeveloper[]
  tasks         Task[]
  logs          ProjectLog[]
  requestValues ProjectRequestFieldValue[]
}

model ProjectDeveloper {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TaskStatusLabel {
  id        String     @id @default(uuid())
  status    TaskStatus @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ProjectLog {
  id         String   @id @default(uuid())
  message    String   @db.Text
  projectId  String
  authorName String
  isInternal Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  attachments ProjectLogAttachment[]
}

model ProjectLogAttachment {
  id        String   @id @default(uuid())
  logId     String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int
  createdAt DateTime @default(now())
  log       ProjectLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model ProjectRequestField {
  id          String   @id @default(uuid())
  key         String?  @unique
  label       String
  placeholder String
  helperText  String?  @db.Text
  order       Int
  isSystem    Boolean  @default(false)
  fieldType   RequestFieldType @default(TEXT)
  options     String?  @db.Text
  required    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  values      ProjectRequestFieldValue[]
}

model ProjectRequestFieldValue {
  id        String              @id @default(uuid())
  projectId String
  fieldId   String
  value     String              @db.Text
  createdAt DateTime            @default(now())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field     ProjectRequestField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}
