generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  COORDINATOR
  DEV_GLOBAL
  DEV_RESTRICTED
  // Same permissions as COORDINATOR (see isCoordination in lib/roles.ts).
  TECH_LEAD
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  IN_QUEUE
  IN_ANALYSIS
  IN_DEVELOPMENT
  IN_TESTING
  FINISHED
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  WAITING
  PAUSED
  DONE
  DEPLOYED
  CANCELED
}

enum RequestFieldType {
  TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  RADIO
  DATE
}

model User {
  id                String             @id @default(uuid())
  login             String             @unique
  name              String
  email             String             @unique
  department        String
  role              Role               @default(REQUESTER)
  isActive          Boolean            @default(true)
  // Created by the public request form after e-mail confirmation. Guests
  // cannot sign in; a coordinator registering the same e-mail promotes them.
  isGuest           Boolean            @default(false)
  // Also send notifications by e-mail (they always appear in the app).
  emailNotifications Boolean           @default(true)
  createdAt         DateTime           @default(now())
  notifications     Notification[]
  requestedProjects Project[]          @relation("ProjectRequester")
  assignedProjects  ProjectDeveloper[]
  tasks             Task[]
}

model Project {
  id            String             @id @default(uuid())
  title         String
  description   String             @db.Text
  justification String             @db.Text
  status        ProjectStatus      @default(IN_QUEUE)
  priority      ProjectPriority    @default(MEDIUM)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  requesterId   String
  requester     User               @relation("ProjectRequester", fields: [requesterId], references: [id])
  // Secret in the public tracking link (/acompanhar/<token>) of requests
  // opened through the public form.
  trackingToken String?            @unique
  // Delivery forecast set by the team. A date, not a moment: stored as DATE so
  // it never shifts with the time zone.
  dueDate       DateTime?                  @db.Date
  // Why the request was cancelled or refused; shown to the requester.
  closeReason   String?                    @db.Text
  developers    ProjectDeveloper[]
  tasks         Task[]
  logs          ProjectLog[]
  requestValues ProjectRequestFieldValue[]
  statusChanges ProjectStatusChange[]
}

// One row per status change, so reports can tell how long a project stayed in
// each status. Rows written by the migration that introduced this table are a
// baseline (current status, dated by the last update) and only approximate.
model ProjectStatusChange {
  id            String         @id @default(uuid())
  projectId     String
  fromStatus    ProjectStatus?
  toStatus      ProjectStatus
  changedByName String
  createdAt     DateTime       @default(now())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectDeveloper {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @db.Date
  assigneeId  String?
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TaskStatusLabel {
  id        String     @id @default(uuid())
  status    TaskStatus @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ProjectLog {
  id         String   @id @default(uuid())
  message    String   @db.Text
  projectId  String
  authorName String
  isInternal Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  attachments ProjectLogAttachment[]
}

model ProjectLogAttachment {
  id        String   @id @default(uuid())
  logId     String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int
  createdAt DateTime @default(now())
  log       ProjectLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model ProjectRequestField {
  id          String   @id @default(uuid())
  key         String?  @unique
  label       String
  placeholder String
  helperText  String?  @db.Text
  order       Int
  isSystem    Boolean  @default(false)
  fieldType   RequestFieldType @default(TEXT)
  options     String?  @db.Text
  required    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  values      ProjectRequestFieldValue[]
}

// Public submission waiting for the e-mail confirmation link. Nothing reaches
// User/Project until it is confirmed, so unverified spam stays out of the queue.
// Something the person should know about: shown in the bell and, unless they
// opted out, sent by e-mail. dedupeKey (already scoped to the user) lets
// scheduled jobs run more than once without notifying twice.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?   @db.Text
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  dedupeKey String?   @unique

  @@index([userId, readAt, createdAt])
}

model PendingGuestRequest {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  name          String
  email         String
  department    String
  title         String
  description   String   @db.Text
  justification String   @db.Text
  customFields  String?  @db.Text
  // JSON list of files uploaded with the form, kept until confirmation.
  attachments   String?  @db.Text
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([email])
  @@index([expiresAt])
}

// Rate limiting for the public routes (kind = "submit-ip", "submit-email", ...).
model PublicRequestAttempt {
  id        String   @id @default(uuid())
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

model ProjectRequestFieldValue {
  id        String              @id @default(uuid())
  projectId String
  fieldId   String
  value     String              @db.Text
  createdAt DateTime            @default(now())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field     ProjectRequestField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}
